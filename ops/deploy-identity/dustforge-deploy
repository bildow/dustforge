#!/bin/bash
# /usr/local/sbin/dustforge-deploy — the only thing the dustforge-deploy user may run as root (sudoers), and the only
# command its forced shell passes on. Installed 2026-11-05 on Aaron's order: RackNerd root is never the deploy
# credential again.
#   dustforge-deploy status            the live commit, the service state, the last backups, the deploy history
#   dustforge-deploy <40-hex sha>      <sha> must be the origin/main tip: back up the DB, fast-forward to it, restart
#   dustforge-deploy rollback          undo the last deploy, one step (code only; the DB is NOT restored — an operator
#                                      act; backups are listed by `status`)
# Refused: a commit not on origin/main, anything but a fast-forward, a changed working tree, a changed
# package.json/package-lock.json (dependency installs run code as root: an operator act), a target that would
# overwrite an ignored file in the live checkout. The credential reaches exactly two states: the current origin/main
# tip, and the commit that was live just before the last deploy — never a feature-branch commit that review held, nor
# a walk back through history (#46 review H1 and its re-review).
# Leak gate (red team item 5): before a deploy merges, the files it changes are scanned for the owner's vault values by
# the scanner root installed (/usr/local/libexec/dustforge-leak-scan.js — never the one in the commit being deployed)
# with the root-only scan token /etc/dustforge-deploy/scan.token. A hit, a missing token or a scan that cannot run
# refuses the deploy (fail closed; an operator deploys by hand in an emergency). A hit also revokes that token.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
umask 077
REPO=/opt/dustforge
DB=$REPO/data/dustforge.db
BK=/opt/backups/dustforge-deploy
STATE=/var/lib/dustforge-deploy
HIST=$STATE/history            # one line per deploy: <iso time> <from sha> <to sha> <deploy|rollback>
g() { git -c safe.directory="$REPO" -C "$REPO" "$@"; }
die() { echo "refused: $*" >&2; exit 3; }
logger -t dustforge-deploy -- "invoked by ${SUDO_USER:-$USER}: $*" 2>/dev/null || true
mkdir -p "$STATE"

restart() {
  local unit="dustforge-deploy-restart-$(date -u +%s)-$RANDOM"
  systemd-run --quiet --collect --on-active=3 --unit="$unit" systemctl restart dustforge \
    || { echo "WARNING: the restart could not be scheduled; the new code is merged but NOT running — an operator restarts dustforge" >&2; exit 4; }
}
backup() {
  mkdir -p "$BK"; chmod 0700 "$BK"
  local f
  f="$BK/dustforge-$(date -u +%Y%m%dT%H%M%SZ)-$(g rev-parse --short=12 HEAD).db"
  sqlite3 "$DB" ".backup $f"
  [ -s "$f" ] || die "backup failed"
  ls -1t "$BK"/dustforge-*.db | tail -n +11 | xargs -r rm -f --
  echo "backup $f"
}
clean_tree() { [ -z "$(g status --porcelain --untracked-files=no)" ] || die "tracked files changed on the server"; }
deps_same() { g diff --quiet "$1" "$2" -- package.json package-lock.json; }
SCANNER=/usr/local/libexec/dustforge-leak-scan.js
SCAN_TOKEN=/etc/dustforge-deploy/scan.token
leak_gate() {   # <from> <to>
  [ -f "$SCANNER" ] || die "leak gate: the scanner is not installed ($SCANNER)"
  [ -f "$SCAN_TOKEN" ] || die "leak gate: no scan token ($SCAN_TOKEN) — an operator places one"
  local t; t=$(mktemp -d); trap 'rm -rf "$t"' RETURN
  # Every path the deploy adds or changes, of any type — renames, copies, type changes (a symlink turned into a file),
  # mode changes — NUL-separated so no file name can split or quote itself (#45 review M1). Deletions bring nothing.
  local n=0 f
  while IFS= read -r -d '' f; do
    n=$((n+1)); mkdir -p "$t/files/$n"
    g cat-file blob "$2:$f" > "$t/files/$n/blob" 2>/dev/null || true   # a submodule or a symlink target is not a blob: nothing to read
  done < <(g diff -z --name-only --no-renames --diff-filter=d "$1" "$2")
  [ "$n" -gt 0 ] || return 0
  local out rc=0
  out=$(DEMIPASS_SCAN_TOKEN_FILE="$SCAN_TOKEN" node "$SCANNER" --strict "$t/files" 2>&1) || rc=$?
  echo "$out" | sed "s#$t/files/#  file #"
  case $rc in
    0) ;;
    1) logger -p auth.crit -t dustforge-deploy -- "leak gate: a vault value is in $2; deploy refused" 2>/dev/null || true; die "leak gate: a vault value is in this commit — the owner was told which and where (DemiPass app, mail); rotate it, remove it, and place a new scan token" ;;
    *) die "leak gate: the scan could not run (exit $rc) — nothing deployed" ;;
  esac
}
# A path the target tracks that is an ignored, untracked file in the live checkout (e.g. a local .env) would be silently
# overwritten by merge/reset: refused (#46 re-review Low).
# Also a path under an ignored file, directory or symlink (racknerd's public/app is an ignored symlink): git would
# replace it with a directory.
no_ignored_clobber() {
  local clash
  clash=$(g ls-tree -r --name-only "$1" | awk 'NR==FNR { ign[$0]=1; next }
    { p=$0; if (p in ign) { print p; next } n=split(p, a, "/"); q=""; for (i=1; i<n; i++) { q = q (i>1 ? "/" : "") a[i]; if (q in ign || (q "/") in ign) { print p; break } } }' \
    <(g ls-files -o -i --exclude-standard --directory | sed 's#/$##') - | head -5)
  [ -z "$clash" ] || die "the target would overwrite ignored live path(s): $(echo $clash)"
}
# The code itself keeps git's normal modes (0644/0755): anything that reads /opt/dustforge as non-root (nginx) still can.
gw() { (umask 022; g "$@"); }
record() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $1 $2 $3" >> "$HIST"; }

case "${1:-}" in
  status)
    [ $# -eq 1 ] || die "status takes no arguments"
    g log --oneline -1
    systemctl is-active dustforge 2>/dev/null || true
    { ls -1t "$BK"/dustforge-*.db 2>/dev/null || true; } | head -3
    { tail -n 3 "$HIST" 2>/dev/null || true; }
    exit 0 ;;
  rollback)
    [ $# -eq 1 ] || die "usage: dustforge-deploy rollback (undo the last deploy, one step)"
    live=$(g rev-parse HEAD)
    # One step only: the history's LAST line must be the deploy that landed the live commit (a rollback after a
    # rollback, or after anything else, is refused).
    last=$({ tail -n 1 "$HIST" 2>/dev/null || true; })
    read -r _ to landed kind <<< "$last" || true
    [ "${kind:-}" = deploy ] && [ "${landed:-}" = "$live" ] && [[ "${to:-}" =~ ^[0-9a-f]{40}$ ]] \
      || die "rollback undoes the last deploy only, once; an operator moves further back"
    g merge-base --is-ancestor "$to" HEAD || die "$to is not an ancestor of the live commit"
    clean_tree
    deps_same "$to" "$live" || die "dependencies differ; an operator rolls this back"
    no_ignored_clobber "$to"
    backup
    gw reset -q --keep "$to"
    record "$live" "$to" rollback
    restart
    echo "rolled back $live -> $to; dustforge restarts in 3 s"
    exit 0 ;;
esac

[ $# -eq 1 ] && [[ "$1" =~ ^[0-9a-f]{40}$ ]] || die "usage: dustforge-deploy <40-hex sha> | status | rollback"
sha=$1
g fetch -q origin "+refs/heads/main:refs/remotes/origin/main"
[ "$sha" = "$(g rev-parse refs/remotes/origin/main)" ] || die "$sha is not the origin/main tip (only the tip is deployed)"
prev=$(g rev-parse HEAD)
[ "$prev" != "$sha" ] || { echo "already at $sha"; exit 0; }
g merge-base --is-ancestor "$prev" "$sha" || die "not a fast-forward from $prev"
clean_tree
deps_same "$prev" "$sha" || die "dependencies changed; an operator installs them"
no_ignored_clobber "$sha"
leak_gate "$prev" "$sha"
backup
gw merge -q --ff-only "$sha"
record "$prev" "$sha" deploy
restart
echo "deployed $prev -> $sha; dustforge restarts in 3 s"
